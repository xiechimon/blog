<script>
/**
 * ImageZoom — 复用型图片灯箱，支持单图放大与多图左右翻页
 * - 单阶段 FLIP：开场即按最终盒子（自然尺寸适配 + 题注预留）布局，
 *   起始帧仅用 transform 复现缩略图位置，动画落点即终点，无二次跳变
 * - 题注栏与计数在遮罩层 flex 列中位于图片下方，不覆盖图片
 * - 复用全局样式 .zoom-overlay / .zoom-img（src/styles/global.css）
 * - 零外部依赖，纯原生实现
 */
let overlay: HTMLDivElement | null = null
let zoomedImg: HTMLImageElement | null = null
let prevBtn: HTMLButtonElement | null = null
let nextBtn: HTMLButtonElement | null = null
let closeBtn: HTMLButtonElement | null = null
let captionBar: HTMLDivElement | null = null
let captionEl: HTMLSpanElement | null = null
let counterEl: HTMLSpanElement | null = null

let gallery: HTMLImageElement[] = []
let currentIndex = 0
let isOpen = false
let isAnimating = false
let firstFrame = '' // FLIP 起始 transform，关闭时回弹用
let touchStartX = 0
let touchStartY = 0

// 题注栏（含间距）在垂直方向预留的高度
const CAPTION_RESERVE = 96

// ---------- DOM 收集 ----------
function collectImages(): void {
  // 优先取文章正文，其次全页 heti 区域，兜底全文档
  const root
    = (document.getElementById('post-content') as HTMLElement | null)
      ?? (document.querySelector('article.heti') as HTMLElement | null)
      ?? document.body

  const imgs = Array.from(root.querySelectorAll('img')) as HTMLImageElement[]
  gallery = imgs.filter((img) => {
    // 排除：链接内的图片、装饰性小图
    if (img.closest('a'))
      return false
    if (img.closest('.no-heti'))
      return false
    if (img.complete && img.naturalWidth > 0 && img.naturalWidth < 80 && img.naturalHeight < 80) {
      return false
    }
    // 过滤不可见
    if (img.offsetParent === null && img.getClientRects().length === 0)
      return false
    return true
  })
}

// ---------- 元素创建（复用全局样式） ----------
function setupOverlay(): void {
  // 避免重复创建（应对 astro:page-load 多次触发）
  if (overlay && document.body.contains(overlay)) {
    collectImages()
    return
  }

  overlay = document.createElement('div')
  overlay.className = 'zoom-overlay'
  overlay.setAttribute('role', 'presentation')
  overlay.setAttribute('aria-hidden', 'true')

  zoomedImg = document.createElement('img')
  zoomedImg.className = 'zoom-img'
  zoomedImg.alt = ''
  zoomedImg.style.opacity = '0'

  prevBtn = document.createElement('button')
  prevBtn.className = 'zoom-nav zoom-prev'
  prevBtn.type = 'button'
  prevBtn.setAttribute('aria-label', '上一张')
  prevBtn.innerHTML
    = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 18L9 12L15 6"/></svg>'

  nextBtn = document.createElement('button')
  nextBtn.className = 'zoom-nav zoom-next'
  nextBtn.type = 'button'
  nextBtn.setAttribute('aria-label', '下一张')
  nextBtn.innerHTML
    = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6L15 12L9 18"/></svg>'

  closeBtn = document.createElement('button')
  closeBtn.className = 'zoom-close'
  closeBtn.type = 'button'
  closeBtn.setAttribute('aria-label', '关闭')
  closeBtn.innerHTML
    = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6L6 18M6 6L18 18"/></svg>'

  captionBar = document.createElement('div')
  captionBar.className = 'zoom-caption-bar'
  captionBar.setAttribute('aria-live', 'polite')
  captionEl = document.createElement('span')
  captionEl.className = 'zoom-caption'
  counterEl = document.createElement('span')
  counterEl.className = 'zoom-counter'
  captionBar.append(captionEl, counterEl)

  // 图片与题注栏放在遮罩的 flex 列里（题注在图片下方）；按钮挂在 body 上
  overlay.append(zoomedImg, captionBar)
  document.body.append(overlay, prevBtn, nextBtn, closeBtn)

  // DEV 兜底：软导航后 UnoCSS 样式可能尚未生效（上游 astro#16373，Layout 内有修复但异步），
  // 内联 opacity 防止按钮在类样式落地前以 opacity 1 闪现；updateChrome 显示时清除内联交还类样式
  if (prevBtn)
    prevBtn.style.opacity = '0'
  if (nextBtn)
    nextBtn.style.opacity = '0'
  if (closeBtn)
    closeBtn.style.opacity = '0'

  // 事件
  overlay.addEventListener('click', closeViewer)
  closeBtn.addEventListener('click', (e) => {
    e.stopPropagation()
    closeViewer()
  })
  prevBtn.addEventListener('click', (e) => {
    e.stopPropagation()
    navigate(-1)
  })
  nextBtn.addEventListener('click', (e) => {
    e.stopPropagation()
    navigate(1)
  })
  zoomedImg.addEventListener('click', (e) => {
    e.stopPropagation()
    // 单图：点图关闭；多图：点图下一张（更符合相册直觉）
    if (gallery.length > 1)
      navigate(1)
    else closeViewer()
  })
  // 键盘与触摸
  document.addEventListener('keydown', handleKeydown)
  zoomedImg.addEventListener('touchstart', handleTouchStart, { passive: true })
  zoomedImg.addEventListener('touchend', handleTouchEnd, { passive: true })

  collectImages()
}

function cleanupViewer(): void {
  // 页面切换前收尾：关闭并清理状态，保留 DOM 供下一次复用
  if (!isOpen)
    return
  isOpen = false
  isAnimating = false
  if (overlay) {
    overlay.style.display = 'none'
    overlay.style.opacity = '0'
  }
  if (zoomedImg) {
    zoomedImg.style.opacity = '0'
    zoomedImg.style.transform = ''
  }
  hideChrome()
  document.body.style.overflow = ''
}

// ---------- 工具 ----------
function getCaption(img: HTMLImageElement): string {
  const alt = img.getAttribute('alt')?.trim() ?? ''
  if (!alt || alt.startsWith('_'))
    return ''
  return alt
}

/** 计算图片的最终展示盒子：自然尺寸适配 90% 视口，题注可见时预留其空间 */
function computeBox(img: HTMLImageElement): { w: number, h: number } {
  const vw = window.innerWidth
  const vh = window.innerHeight
  const showBar = getCaption(img) !== '' || gallery.length > 1
  const maxW = vw * 0.9
  const maxH = vh * 0.92 - (showBar ? CAPTION_RESERVE : 0)
  const nw = img.naturalWidth || img.width || 1
  const nh = img.naturalHeight || img.height || 1
  const s = Math.min(maxW / nw, maxH / nh)
  return { w: Math.round(nw * s), h: Math.round(nh * s) }
}

function updateChrome(): void {
  if (!captionEl || !counterEl || !captionBar || !prevBtn || !nextBtn || !closeBtn)
    return

  // 清除 DEV 兜底的内联 opacity，显示/隐藏自此由类样式接管
  prevBtn.style.opacity = ''
  nextBtn.style.opacity = ''
  closeBtn.style.opacity = ''

  const cap = getCaption(gallery[currentIndex])
  captionEl.textContent = cap
  captionEl.style.display = cap ? '' : 'none'

  if (gallery.length > 1) {
    counterEl.textContent = `${currentIndex + 1} / ${gallery.length}`
    counterEl.style.display = ''
    prevBtn.classList.add('is-visible')
    nextBtn.classList.add('is-visible')
  }
  else {
    counterEl.style.display = 'none'
    prevBtn.classList.remove('is-visible')
    nextBtn.classList.remove('is-visible')
  }

  // 有题注或计数时才显示底栏
  const showBar = cap !== '' || gallery.length > 1
  captionBar.classList.toggle('is-visible', showBar)
  closeBtn.classList.add('is-visible')

  if (zoomedImg) {
    zoomedImg.classList.toggle('is-gallery', gallery.length > 1)
  }
}

function hideChrome(): void {
  prevBtn?.classList.remove('is-visible')
  nextBtn?.classList.remove('is-visible')
  closeBtn?.classList.remove('is-visible')
  captionBar?.classList.remove('is-visible')
}

function preload(idx: number): void {
  if (gallery.length === 0)
    return
  const i = (idx + gallery.length) % gallery.length
  const el = gallery[i]
  if (!el)
    return
  const src = (el as HTMLImageElement & { currentSrc?: string }).currentSrc || el.src
  if (!src)
    return
  const im = new Image()
  im.src = src
}

function isValidTarget(img: HTMLImageElement): boolean {
  if (!img.complete)
    return true // 未加载完成也允许点开
  if (img.naturalWidth < 100 || img.naturalHeight < 100)
    return false
  return true
}

// ---------- 打开 / 关闭 / 翻页 ----------
function openAt(index: number): void {
  if (!overlay || !zoomedImg)
    return
  if (gallery.length === 0)
    collectImages()
  if (index < 0 || index >= gallery.length)
    return

  const target = gallery[index]
  if (!isValidTarget(target))
    return

  currentIndex = index
  isOpen = true

  const rect = target.getBoundingClientRect()
  const src = (target as HTMLImageElement & { currentSrc?: string }).currentSrc || target.src
  const box = computeBox(target)

  // 直接摆到最终布局（流内居中 + 显式盒子）
  zoomedImg.src = src
  zoomedImg.alt = target.alt || ''
  zoomedImg.style.width = `${box.w}px`
  zoomedImg.style.height = `${box.h}px`
  overlay.style.display = 'flex'
  void zoomedImg.offsetWidth
  document.body.style.overflow = 'hidden'
  updateChrome()

  // FLIP 起始帧：用 transform 把居中的最终盒子复现到缩略图位置与大小
  const vw = window.innerWidth
  const vh = window.innerHeight
  const dx = rect.left + rect.width / 2 - vw / 2
  const dy = rect.top + rect.height / 2 - vh / 2
  const s = rect.width / box.w
  firstFrame = `translate(${dx}px, ${dy}px) scale(${s})`

  zoomedImg.style.transition = 'none'
  zoomedImg.style.transform = firstFrame
  zoomedImg.style.opacity = '0'
  void zoomedImg.offsetWidth // 强制回流，保证从起始帧开始过渡

  // 翻转到最终态：rAF 优先（保证起始帧先绘制），后台/遮挡窗口 rAF 可能长时间
  // 不触发，加定时器兜底；flipped 保证双触发幂等
  let flipped = false
  const flip = () => {
    if (flipped || !overlay || !zoomedImg)
      return
    flipped = true
    overlay.style.opacity = '1'
    zoomedImg.style.transition = ''
    zoomedImg.style.opacity = '1'
    zoomedImg.style.transform = 'translate(0, 0) scale(1)'
  }
  requestAnimationFrame(flip)
  window.setTimeout(flip, 60)

  preload(currentIndex + 1)
  preload(currentIndex - 1)
}

function closeViewer(): void {
  if (!isOpen || !overlay || !zoomedImg)
    return
  isOpen = false

  overlay.style.opacity = '0'
  hideChrome()

  // 回弹到缩略图位置（反向 FLIP）
  zoomedImg.style.opacity = '0'
  zoomedImg.style.transform = firstFrame || 'scale(0.96)'

  window.setTimeout(() => {
    if (!overlay || !zoomedImg)
      return
    overlay.style.display = 'none'
    zoomedImg.style.transform = ''
    document.body.style.overflow = ''
  }, 320)
}

function navigate(dir: 1 | -1): void {
  if (!isOpen || gallery.length <= 1)
    return
  if (isAnimating)
    return

  const nextIndex = (currentIndex + dir + gallery.length) % gallery.length
  if (nextIndex === currentIndex)
    return

  isAnimating = true
  if (!zoomedImg)
    return

  // 淡出并轻微位移
  zoomedImg.style.opacity = '0'
  zoomedImg.style.transform = `translate(${dir > 0 ? '-10px' : '10px'}, 0) scale(0.98)`

  window.setTimeout(() => {
    if (!zoomedImg)
      return
    currentIndex = nextIndex
    const target = gallery[currentIndex]
    const src = (target as HTMLImageElement & { currentSrc?: string }).currentSrc || target.src
    const box = computeBox(target)
    updateChrome()

    const applyBox = () => {
      if (!zoomedImg)
        return
      zoomedImg.style.width = `${box.w}px`
      zoomedImg.style.height = `${box.h}px`
      zoomedImg.style.transform = 'translate(0, 0) scale(1)'
      zoomedImg.style.opacity = '1'
      window.setTimeout(() => {
        isAnimating = false
      }, 300)
    }

    // 先替换 src，等待加载完成再淡入，避免闪白
    zoomedImg.onload = () => {
      if (!zoomedImg)
        return
      zoomedImg.onload = null
      applyBox()
    }
    zoomedImg.onerror = () => {
      if (!zoomedImg)
        return
      zoomedImg.onerror = null
      isAnimating = false
    }
    zoomedImg.src = src
    zoomedImg.alt = target.alt || ''
    // 若已缓存，onload 可能不触发
    if (zoomedImg.complete) {
      requestAnimationFrame(() => {
        if (zoomedImg && zoomedImg.onload) {
          zoomedImg.onload = null
          applyBox()
        }
      })
    }

    preload(currentIndex + 1)
    preload(currentIndex - 1)
  }, 180)
}

// ---------- 事件 ----------
function handleKeydown(e: KeyboardEvent): void {
  if (!isOpen)
    return
  if (e.key === 'Escape') {
    e.preventDefault()
    closeViewer()
  }
  else if (e.key === 'ArrowLeft') {
    if (gallery.length > 1) {
      e.preventDefault()
      navigate(-1)
    }
  }
  else if (e.key === 'ArrowRight') {
    if (gallery.length > 1) {
      e.preventDefault()
      navigate(1)
    }
  }
}

function handleTouchStart(e: TouchEvent): void {
  if (!isOpen || gallery.length <= 1)
    return
  const t = e.touches[0]
  touchStartX = t.clientX
  touchStartY = t.clientY
}

function handleTouchEnd(e: TouchEvent): void {
  if (!isOpen || gallery.length <= 1)
    return
  const t = e.changedTouches[0]
  const dx = t.clientX - touchStartX
  const dy = t.clientY - touchStartY
  // 横滑阈值 > 50，且横向位移大于纵向
  if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.2) {
    navigate(dx < 0 ? 1 : -1)
  }
}

function handleClick(e: MouseEvent): void {
  if (isOpen)
    return // 打开时由 overlay/按钮/图片各自处理
  const target = e.target
  if (!(target instanceof HTMLImageElement))
    return
  const idx = gallery.indexOf(target)
  if (idx === -1) {
    // 可能是新插入的图片，重新收集后重试
    collectImages()
    const retryIdx = gallery.indexOf(target)
    if (retryIdx === -1)
      return
    if (!isValidTarget(target))
      return
    e.preventDefault()
    openAt(retryIdx)
    return
  }
  if (!isValidTarget(target))
    return
  e.preventDefault()
  openAt(idx)
}

// ---------- 生命周期（复用 Astro View Transitions） ----------
document.addEventListener('astro:page-load', setupOverlay)
document.addEventListener('astro:before-swap', cleanupViewer)
document.addEventListener('click', handleClick)
window.addEventListener('resize', () => {
  if (isOpen)
    closeViewer()
})
</script>
