---
import PostList from '@/components/PostList.astro'
import { allLocales } from '@/config'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import Layout from '@/layouts/Layout.astro'
import { getPostsGroupByYear } from '@/utils/content'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const currentLang = getLangFromLocale(Astro.currentLocale)
const yearGroups = await getPostsGroupByYear(currentLang)
const countUnit = currentLang.startsWith('zh') ? ' 篇' : ''
---

<Layout>
  <!-- Decorative Line -->
  <div class="uno-decorative-line" />

  <!-- Posts Grouped by Year -->
  {[...yearGroups.entries()].map(([year, posts]) => (
    <section>
      <h2 class="mb-3.5 mt-10.5 text-5 c-primary font-bold first:mt-0 cjk:tracking-wide">
        {year}
        <span class="ml-1.5 text-3.5 c-secondary font-medium font-time">
          · {posts.length}{countUnit}
        </span>
      </h2>
      <PostList
        posts={posts}
        lang={currentLang}
      />
    </section>
  ))}
</Layout>
