---
import PostList from '@/components/PostList.astro'
import { allLocales } from '@/config'
import { interviewData } from '@/data/interview'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import Layout from '@/layouts/Layout.astro'
import { getPosts } from '@/utils/content'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const currentLang = getLangFromLocale(Astro.currentLocale)
const { totalPosts, dateRange, companiesCovered, topics, companies, relatedPostIds } = interviewData

const relatedPosts = (await getPosts(currentLang)).filter(post =>
  relatedPostIds.includes(post.id),
)

const pageTitle = `AI 全栈面经汇总 ${dateRange}`
const pageDesc = `基于牛客 ${totalPosts} 篇 AI 全栈/Agent 面经的统计：${topics.length} 大命题、TOP 10 公司、每命题 TOP 10 高频考点`
---

<Layout
  postTitle={pageTitle}
  postDescription={pageDesc}
>
  <!-- Decorative Line -->
  <div class="uno-decorative-line" />

  <!-- 标题区 -->
  <header class="mb-8">
    <h1 class="text-5 c-primary font-bold cjk:tracking-wide">
      AI 全栈面经汇总
    </h1>
    <p class="mt-3 text-4.5 c-secondary">
      基于牛客 {totalPosts} 篇面经的统计 · {dateRange}
    </p>
    <p class="mt-2 text-3.5 c-secondary/70">
      覆盖 {companiesCovered} 家公司 · 一篇面经可命中多个命题，各命题占比之和大于 100%
    </p>
  </header>

  <!-- 总体 KPI -->
  <section class="mb-10 flex flex-wrap gap-x-4 gap-y-3 text-3.5 c-secondary">
    <span class="border border-secondary/25 rounded-full px-4 py-1.5">
      样本：<b class="c-primary font-medium">{totalPosts}</b> 篇
    </span>
    <span class="border border-secondary/25 rounded-full px-4 py-1.5">
      覆盖公司：<b class="c-primary font-medium">{companiesCovered}</b> 家
    </span>
    <span class="border border-secondary/25 rounded-full px-4 py-1.5">
      时间：{dateRange}
    </span>
  </section>

  <!-- 六大命题 -->
  <section class="mb-12" id="topics">
    <h2 class="mb-6 text-4.5 c-primary font-bold cjk:tracking-wide">
      六大命题分布
    </h2>
    <div class="flex flex-col gap-9">
      {topics.map(topic => (
        <div id={topic.id} class="scroll-my-24">
          <!-- 章节 chip + 篇数 -->
          <div class="mb-2.5 flex items-baseline gap-3">
            <span class="inline-block border border-secondary/25 rounded-full bg-secondary/5 px-3.2 py-0.7 c-primary font-medium">
              {topic.label}
            </span>
            <span class="text-3.5 c-secondary font-time">
              {topic.count} 篇 · {topic.percent}%
            </span>
          </div>

          <!-- 百分比条形（动态宽度用内联 style） -->
          <div class="mb-3 h-2 overflow-hidden rounded-full bg-secondary/10">
            <div
              class="h-full rounded-full bg-secondary/60"
              style={`width: ${topic.percent}%`}
              role="img"
              aria-label={`${topic.label} ${topic.percent}%`}
            />
          </div>

          <!-- TOP10 考点胶囊 -->
          <ul class="flex flex-wrap gap-2">
            {topic.points.map((point, index) => (
              <li
                class="inline-flex items-center gap-1.5 border border-secondary/20 rounded-full px-2.5 py-0.6 text-3.2 c-secondary"
              >
                <span class="c-primary/70 font-medium">{index + 1}</span>
                <span>{point.name}</span>
                <span class="text-2.8 c-secondary/60 font-time">{point.count} 篇</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- TOP 10 公司 -->
  <section class="mb-12" id="companies">
    <h2 class="mb-6 text-4.5 c-primary font-bold cjk:tracking-wide">
      TOP 10 公司
    </h2>
    <ol class="flex flex-col gap-4">
      {companies.map(company => (
        <li class="border border-secondary/10 rounded-lg bg-secondary/5 px-4 py-3">
          <div class="mb-1.5 flex items-baseline justify-between gap-4">
            <span class="c-primary font-medium">
              {company.rank}. {company.name}
            </span>
            <span class="text-3.5 c-secondary font-time">
              {company.count} 篇 · {company.percent}%
            </span>
          </div>

          <div class="mb-2 h-1.5 overflow-hidden rounded-full bg-secondary/10">
            <div
              class="h-full rounded-full bg-secondary/55"
              style={`width: ${company.percent}%`}
            />
          </div>

          <div class="flex flex-wrap gap-1.5">
            {company.topTopics.map(topic => (
              <span class="border border-secondary/20 rounded-full px-2 py-0.5 text-2.9 c-secondary/80">
                {topic}
              </span>
            ))}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- 深度阅读 -->
  <section class="mb-6" id="related">
    <div class="mb-5 uno-decorative-line" />
    <h2 class="mb-5 text-4.5 c-primary font-bold cjk:tracking-wide">
      深度阅读
    </h2>
    <PostList posts={relatedPosts} lang={currentLang} />
  </section>
</Layout>
