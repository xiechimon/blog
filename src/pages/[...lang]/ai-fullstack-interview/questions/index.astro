---
import { allLocales } from '@/config'
import { questionGroups, sourceMeta, totalQuestions } from '@/data/questions'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import { getCategoryPath } from '@/i18n/path'
import Layout from '@/layouts/Layout.astro'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const currentLang = getLangFromLocale(Astro.currentLocale)

const pageTitle = `AI 全栈面经题库（${sourceMeta.postCount} 篇 · ${totalQuestions} 题）`
const pageDesc = `基于牛客 ${sourceMeta.postCount} 篇 AI 全栈/Agent 面经，按 ${questionGroups.length} 大命题分组、共 ${totalQuestions} 道真实题目，每题附来源公司与原帖链接。`
---

<Layout
  postTitle={pageTitle}
  postDescription={pageDesc}
>
  <!-- Decorative Line -->
  <div class="uno-decorative-line" />

  <!-- 标题区 -->
  <header class="mb-10">
    <h1 class="text-5 c-primary font-bold cjk:tracking-wide">
      AI 全栈面经题库
    </h1>
    <p class="mt-3 text-4.5 c-secondary">
      基于牛客 {sourceMeta.postCount} 篇面经 · 共 {totalQuestions} 道真实题目
    </p>
    <p class="mt-2 text-3.5 c-secondary/70">
      {sourceMeta.dateRange} · 按 {questionGroups.length} 大命题分组 · 每题附来源公司与原帖
    </p>
  </header>

  <!-- 7 大分类卡片概览 -->
  <div class="grid gap-4 sm:(grid-cols-2)">
    {questionGroups.map(group => (
      <a
        href={getCategoryPath(group.category, currentLang)}
        class="uno-round-border bg-secondary/5 p-5 transition-colors hover:(border-secondary/30 bg-secondary/10)"
      >
        <h2 class="text-4.5 c-primary font-bold cjk:tracking-wide">
          {group.label}
        </h2>
        <p class="mt-2 text-3.5 c-secondary">
          {group.questions.length} 题
        </p>
        <span class="mt-3 inline-block text-3 c-secondary">
          进入该类 →
        </span>
      </a>
    ))}
  </div>
</Layout>
