---
import { allLocales } from '@/config'
import { questionGroups, sourceMeta, totalQuestions } from '@/data/questions'
import { getLangRouteParam } from '@/i18n/lang'
import Layout from '@/layouts/Layout.astro'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

// 预取每个分组的全局起始编号，实现跨分组连续编号 1..N（题库宜连续编号）
let running = 0
const questionGroupsWithStart = questionGroups.map((group) => {
  const startIndex = running + 1
  running += group.questions.length
  return {
    category: group.category,
    label: group.label,
    questions: group.questions,
    startIndex,
  }
})

const pageTitle = `AI 全栈面经题库（${sourceMeta.postCount} 篇 · ${totalQuestions} 题）`
const pageDesc = `基于牛客 ${sourceMeta.postCount} 篇 AI 全栈/Agent 面经，按 ${questionGroupsWithStart.length} 大命题分组、共 ${totalQuestions} 道真实题目，每题附来源公司与原帖链接。`
---

<Layout
  postTitle={pageTitle}
  postDescription={pageDesc}
>
  <!-- Decorative Line -->
  <div class="uno-decorative-line" />

  <!-- 标题区 -->
  <header class="mb-10">
    <h1 class="text-5 c-primary font-bold cjk:tracking-wide">
      AI 全栈面经题库
    </h1>
    <p class="mt-3 text-4.5 c-secondary">
      基于牛客 {sourceMeta.postCount} 篇面经 · 共 {totalQuestions} 道真实题目
    </p>
    <p class="mt-2 text-3.5 c-secondary/70">
      {sourceMeta.dateRange} · 按 {questionGroupsWithStart.length} 大命题分组 · 每题附来源公司与原帖
    </p>
  </header>

  <!-- 左侧固定目录（xl 下固定左，复用 TOC 定位思路 + details 树状展开） -->
  <nav
    aria-label="题库目录"
    class="mb-8 uno-round-border bg-secondary/5 p-4 xl:(fixed left-0 top-20 max-w-[min(calc(50vw-29.5rem),13rem)] border-none bg-secondary/0 p-0)"
  >
    <ul id="toc-links-list" class="flex flex-wrap gap-x-3 gap-y-2 text-3.5 xl:(flex-col gap-y-0.5)">
      {questionGroupsWithStart.map(group => (
        <li>
          <details>
            <summary class="xl:no-heti xl:toc-links-h2 c-primary font-medium">
              {group.label}
              <span class="ml-1 c-secondary/70 font-time">{group.questions.length}</span>
            </summary>
            <ul class="ml-2 mt-1 space-y-0.5 xl:(border-l border-secondary/15 pl-3)">
              {group.questions.map(question => (
                <li>
                  <a href={`#${question.id}`} class="xl:no-heti xl:toc-links-h3">
                    {question.text}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </li>
      ))}
    </ul>
  </nav>

  <!-- 六大命题分组 -->
  {questionGroupsWithStart.map(group => (
    <section id={group.category} class="mb-12 scroll-my-24">
      <h2 class="mb-5 text-4.5 c-primary font-bold cjk:tracking-wide">
        {group.label}
        <span class="ml-1.5 text-3.5 c-secondary font-medium font-time">
          · {group.questions.length} 题
        </span>
      </h2>

      <!-- 每题一行 -->
      <ol class="flex flex-col">
        {group.questions.map((question, index) => (
          <li id={question.id} class="flex flex-col scroll-mt-24 gap-1.5 border-b border-secondary/15 py-3.5">
            <p class="lead-7.5 text-4 c-primary">
              <span class="mr-2 text-3.2 c-secondary/70 font-time">{group.startIndex + index}.</span>
              {question.text}
            </p>

            <!-- 来源公司胶囊 + 来源原文链接 -->
            <div class="flex flex-wrap items-center gap-2.5">
              {question.company && (
                <span class="border border-secondary/20 rounded-full px-2.5 py-0.5 text-3 c-secondary/80">
                  {question.company}
                </span>
              )}
              {question.sourceUrl && (
                <a
                  href={question.sourceUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-3 c-secondary underline-offset-2 transition-colors hover:(c-primary)"
                >
                  来源原文 ↗
                </a>
              )}
            </div>
          </li>
        ))}
      </ol>
    </section>
  ))}
</Layout>

<script>
// 复用 TOC.astro 思路的滚动高亮：让题库目录随滚动高亮当前分类/题目
const tocList = document.getElementById('toc-links-list')

interface TocEntry { link: HTMLAnchorElement, el: HTMLElement }

function updateActive() {
  if (!tocList) {
    return
  }
  const links = Array.from(tocList.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'))
  if (!links.length) {
    return
  }

  const targets: TocEntry[] = []
  links.forEach((link) => {
    const id = (link.getAttribute('href') || '').replace('#', '')
    const el = document.getElementById(id)
    if (el) {
      targets.push({ link, el })
    }
  })

  let currentId = ''
  for (const { el } of targets) {
    if (el.getBoundingClientRect().top <= 120) {
      currentId = el.id
    }
  }

  links.forEach((link) => {
    const id = (link.getAttribute('href') || '').replace('#', '')
    link.classList.toggle('target-current', id === currentId)
  })
}

function handleScroll() {
  requestAnimationFrame(updateActive)
}

function setupActive() {
  tocList?.querySelectorAll('details').forEach((item) => {
    item.addEventListener('toggle', updateActive)
  })
  document.addEventListener('scroll', handleScroll, { passive: true })
  window.addEventListener('resize', handleScroll)
  updateActive()
}

function cleanupActive() {
  document.removeEventListener('scroll', handleScroll)
  window.removeEventListener('resize', handleScroll)
}

document.addEventListener('astro:page-load', () => {
  setupActive()
})
document.addEventListener('astro:before-swap', () => {
  cleanupActive()
})
</script>
