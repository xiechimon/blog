---
import type { Question, QuestionCategory } from '@/data/questions'
import { allLocales } from '@/config'
import { CATEGORY_LABELS, questionGroups } from '@/data/questions'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import { getQuestionsIndexPath } from '@/i18n/path'
import Layout from '@/layouts/Layout.astro'

export async function getStaticPaths() {
  return allLocales.flatMap((lang) => {
    const langParam = getLangRouteParam(lang)
    return questionGroups.map(group => ({
      params: { lang: langParam, category: group.category },
      props: { category: group.category },
    }))
  })
}

const { category } = Astro.props
const currentLang = getLangFromLocale(Astro.currentLocale)

const group = questionGroups.find(g => g.category === category)!
const label = CATEGORY_LABELS[category]

// 累计全局起始编号（同一道题编号恒定，便于引用）
let running = 0
const startIndexMap = {} as Record<QuestionCategory, number>
for (const g of questionGroups) {
  startIndexMap[g.category] = running + 1
  running += g.questions.length
}
const startIndex = startIndexMap[category]

// 按子技术分组：高频置顶，其余折叠
function buildSubGroups(list: Question[]): { subTech: string, questions: Question[] }[] {
  const subMap = new Map<string, Question[]>()
  for (const q of list) {
    const arr = subMap.get(q.subTech) ?? []
    arr.push(q)
    subMap.set(q.subTech, arr)
  }
  return Array.from(subMap.entries())
    .map(([subTech, questions]) => {
      questions.sort((a, b) => Number(b.hot) - Number(a.hot) || b.coverCount - a.coverCount)
      return { subTech, questions }
    })
    .sort((a, b) => b.questions.length - a.questions.length)
}

const subGroups = buildSubGroups(group.questions)
// 每子技术高频题数（hot）
const HIGHLIGHT_COUNT = 5

const pageTitle = `${label} · AI 全栈面经题库（${group.questions.length} 题）`
const pageDesc = `共 ${group.questions.length} 道真实题目，按 ${subGroups.length} 个子技术分组，高频题标注出现帖数。`
---

<Layout
  postTitle={pageTitle}
  postDescription={pageDesc}
>
  <!-- Decorative Line -->
  <div class="uno-decorative-line" />

  <!-- 标题区 -->
  <header class="mb-8">
    <p class="mb-3 text-3.5 c-secondary">
      <a href={getQuestionsIndexPath(currentLang)} class="transition-colors hover:(c-primary)">
        ← 返回题库概览
      </a>
    </p>
    <h1 class="text-5 c-primary font-bold cjk:tracking-wide">
      {label}
    </h1>
    <p class="mt-3 text-4.5 c-secondary">
      {group.questions.length} 道真实题目 · {subGroups.length} 个子技术
    </p>
  </header>

  <!-- 左侧固定子技术目录（xl 下固定左，复用 TOC 定位） -->
  <nav
    aria-label="子技术目录"
    class="mb-8 uno-round-border bg-secondary/5 p-4 xl:(fixed left-0 top-20 max-w-[min(calc(50vw-29.5rem),13rem)] border-none bg-secondary/0 p-0)"
  >
    <ul class="flex flex-wrap gap-x-3 gap-y-2 text-3.5 xl:(flex-col gap-y-0.5)">
      {subGroups.map(sub => (
        <li>
          <a href={`#${sub.subTech}`} class="xl:no-heti xl:toc-links-h2">
            {sub.subTech}
            <span class="ml-1 c-secondary/70 font-time">{sub.questions.length}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- 子技术分节 -->
  {subGroups.map((sub) => {
    const highlight = sub.questions.filter(q => q.hot).slice(0, HIGHLIGHT_COUNT)
    const collapsed = sub.questions.filter(q => !highlight.includes(q))
    return (
      <section id={sub.subTech} class="mb-12 scroll-my-24">
        <h2 class="mb-5 text-4.5 c-primary font-bold cjk:tracking-wide">
          {sub.subTech}
          <span class="ml-1.5 text-3.5 c-secondary font-medium font-time">
            · {sub.questions.length} 题
          </span>
          {highlight.length > 0 && (
            <span class="ml-2 border border-secondary/20 rounded-full px-2 py-0.5 text-2.9 c-secondary/70">
              高频 {highlight.length}
            </span>
          )}
        </h2>

        <!-- 高频题直接展开 -->
        <ol class="flex flex-col">
          {highlight.map(question => (
            <li id={question.id} class="flex flex-col scroll-mt-24 gap-1.5 border-b border-secondary/15 py-3.5">
              <p class="lead-7.5 text-4 c-primary">
                <span class="mr-2 text-3.2 c-secondary/70 font-time">{startIndex + sub.questions.indexOf(question)}.</span>
                {question.text}
                {question.hot && (
                  <span class="ml-2 border border-secondary/25 rounded-full bg-secondary/5 px-2 py-0.5 text-2.8 c-primary/80">
                    高频 · {question.coverCount} 帖
                  </span>
                )}
              </p>
              <div class="flex flex-wrap items-center gap-2.5">
                {question.company && (
                  <span class="border border-secondary/20 rounded-full px-2.5 py-0.5 text-3 c-secondary/80">
                    {question.company}
                  </span>
                )}
                {question.sourceUrl && (
                  <a
                    href={question.sourceUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-3 c-secondary underline-offset-2 transition-colors hover:(c-primary)"
                  >
                    来源原文 ↗
                  </a>
                )}
              </div>
            </li>
          ))}
        </ol>

        <!-- 其余折叠 -->
        {collapsed.length > 0 && (
          <details class="mt-2">
            <summary class="cursor-pointer text-3.5 c-secondary/70 transition-colors hover:(c-primary)">
              {collapsed.length} 题 · 查看全部
            </summary>
            <ol class="mt-3 flex flex-col">
              {collapsed.map(question => (
                <li id={question.id} class="flex flex-col scroll-mt-24 gap-1.5 border-b border-secondary/15 py-3.5">
                  <p class="lead-7.5 text-4 c-primary">
                    <span class="mr-2 text-3.2 c-secondary/70 font-time">{startIndex + sub.questions.indexOf(question)}.</span>
                    {question.text}
                  </p>
                  <div class="flex flex-wrap items-center gap-2.5">
                    {question.company && (
                      <span class="border border-secondary/20 rounded-full px-2.5 py-0.5 text-3 c-secondary/80">
                        {question.company}
                      </span>
                    )}
                    {question.sourceUrl && (
                      <a
                        href={question.sourceUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-3 c-secondary underline-offset-2 transition-colors hover:(c-primary)"
                      >
                        来源原文 ↗
                      </a>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </details>
        )}
      </section>
    )
  })}
</Layout>
